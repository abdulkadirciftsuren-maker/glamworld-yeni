rules_version = '2';
// GLOXORG — Firebase Depolama (Storage) Güvenlik Kuralları
// Firebase Console > Storage > Rules (Kurallar) sekmesine YAPIŞTIR + Publish (Yayınla).
// Videolar/dosyalar medya/{uid}/... altında saklanır.
//  • Herkes OKUR (akışta oynatılır / indirilir — URL herkese açık, Cloudinary gibi).
//  • SADECE giriş yapan kendi klasörüne (uid) yazar/siler. Yönetici (sahip e-posta) her yeri silebilir (hesap silme).
//  • En fazla 200MB (yükleme). Silme (request.resource yok) serbest.
service firebase.storage {
  match /b/{bucket}/o {

    match /medya/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == uid
                       || request.auth.token.email == "abdulkadirciftsuren@gmail.com")
                   && (request.resource == null || request.resource.size < 200 * 1024 * 1024);
    }

    // Geriye dönük (varsa eski yollar) — kimse takılmasın
    match /videolar/{uid}/{p=**}  { allow read: if true; allow write: if request.auth != null && request.auth.uid == uid; }
    match /gorseller/{uid}/{p=**} { allow read: if true; allow write: if request.auth != null && request.auth.uid == uid; }
  }
}
